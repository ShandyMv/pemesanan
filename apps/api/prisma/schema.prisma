generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  CASHIER
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CASHLESS
}

enum PaymentChannel {
  CASHIER
  SELF_TABLE
}

enum PaymentStatus {
  PAID
  FAILED
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(160)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  payments     Payment[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  description String   @default("") @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  menus       Menu[]

  @@map("categories")
}

model Menu {
  id          Int         @id @default(autoincrement())
  categoryId  Int         @map("category_id")
  name        String      @db.VarChar(140)
  description String      @db.Text
  price       Decimal     @db.Decimal(12, 2)
  imageUrl    String      @map("image_url") @db.VarChar(500)
  isAvailable Boolean     @default(true) @map("is_available")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId], map: "menus_category_id_idx")
  @@map("menus")
}

model CafeTable {
  id          Int      @id @default(autoincrement())
  tableNumber String   @unique @map("table_number") @db.VarChar(30)
  qrCode      String   @unique @map("qr_code") @db.VarChar(80)
  qrUrl       String   @map("qr_url") @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  orders      Order[]

  @@map("tables")
}

model Order {
  id             Int          @id @default(autoincrement())
  tableId        Int          @map("table_id")
  orderCode      String       @unique @map("order_code") @db.VarChar(60)
  publicToken    String       @unique @map("public_token") @db.VarChar(64)
  customerName   String       @default("Customer") @map("customer_name") @db.VarChar(120)
  totalAmount    Decimal      @map("total_amount") @db.Decimal(12, 2)
  status         OrderStatus  @default(PENDING)
  rejectedReason String?      @map("rejected_reason") @db.VarChar(255)
  orderedAt      DateTime     @default(now()) @map("ordered_at")
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  table          CafeTable    @relation(fields: [tableId], references: [id])
  items          OrderItem[]
  payment        Payment?

  @@index([tableId], map: "orders_table_id_idx")
  @@index([status], map: "orders_status_idx")
  @@index([orderedAt], map: "orders_ordered_at_idx")
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  menuId    Int      @map("menu_id")
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  note      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id])
  menu      Menu     @relation(fields: [menuId], references: [id])

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([menuId], map: "order_items_menu_id_idx")
  @@map("order_items")
}

model Payment {
  id            Int            @id @default(autoincrement())
  orderId       Int            @unique @map("order_id")
  cashierId     Int?           @map("cashier_id")
  amountPaid    Decimal        @map("amount_paid") @db.Decimal(12, 2)
  changeAmount  Decimal        @default(0) @map("change_amount") @db.Decimal(12, 2)
  paymentMethod PaymentMethod  @map("payment_method")
  paymentChannel PaymentChannel @default(CASHIER) @map("payment_channel")
  paymentStatus PaymentStatus  @default(PAID) @map("payment_status")
  paidAt        DateTime       @default(now()) @map("paid_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  order         Order          @relation(fields: [orderId], references: [id])
  cashier       User?          @relation(fields: [cashierId], references: [id])

  @@index([cashierId], map: "payments_cashier_id_idx")
  @@index([paidAt], map: "payments_paid_at_idx")
  @@map("payments")
}
